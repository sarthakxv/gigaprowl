{
  "manifest_version": 3,
  "name": "Gigaprowl LinkedIn Engine",
  "version": "0.1.0",
  "description": "Runs your Gigaprowl LinkedIn outreach (connection requests + DMs) from your own browser session. Your cookie never leaves your machine.",
  "permissions": ["storage", "alarms", "tabs", "scripting"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://prowl-livid.vercel.app/*",
    "https://*.vercel.app/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Gigaprowl LinkedIn Engine" },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
