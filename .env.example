# ---- AI (resume parsing, matching explanations, cadence + pitch generation) ----
ANTHROPIC_API_KEY=

# ---- Job sources (all optional; Remotive + Greenhouse/Lever boards work keyless) ----
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ---- Contact discovery ----
# Apollo Master API key (Settings → Integrations → API). People Search needs
# the `mixed_people/api_search` scope — a non-master/scoped key returns 403.
APOLLO_API_KEY=

# ---- Hiring signals (Parallel API; no fabricated production fallback) ----
PARALLEL_API_KEY=
# Optional: processor tier (base|core|pro|ultra — default base) and result timeout in ms
# PARALLEL_PROCESSOR=base
# PARALLEL_TIMEOUT_MS=20000
# Deep role research (drives the video's "what I'd do for you" scene)
# PARALLEL_RESEARCH_PROCESSOR=core
# PARALLEL_RESEARCH_TIMEOUT_MS=28000

# ---- AI mockup image for the pitch video ----
# Claude designs an SVG mockup which we rasterize to PNG — uses ANTHROPIC_API_KEY
# above, no separate image API needed. Falls back to the researched "ideas" slide.

# ---- App URL + Supabase Auth ----
# Configure Google sign-in, allowed redirect URLs, and Resend SMTP in the
# Supabase dashboard. Supabase owns magic links; Resend only delivers them.
APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Transaction-pooler URLs for restricted gigaprowl_app and gigaprowl_worker
# roles. Set role passwords outside migrations. Never expose these to clients.
DATABASE_URL=postgresql://gigaprowl_app.<project-ref>:<password>@<pooler-host>:6543/postgres
WORKER_DATABASE_URL=postgresql://gigaprowl_worker.<project-ref>:<password>@<pooler-host>:6543/postgres
# Apply supabase/migrations with a separate direct/admin connection; do not
# configure that credential in the deployed Next.js runtime.

# ---- Expiring KV: OAuth state, short-lived caches, caps, and leases only ----
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---- Outreach sending (export integrations) ----
SMARTLEAD_API_KEY=
PHANTOMBUSTER_API_KEY=

# --- Outreach: Gmail send-as (Google OAuth). Exclusive outreach provider. ---
# Production callback (must match Google Cloud OAuth client and PRODUCTION_APP_URL in src/lib/constants.js):
#   https://gigaprowl.vercel.app/api/connect/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32-byte AES-256-GCM key as 64 hex chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GMAIL_TOKEN_ENCRYPTION_KEY=

# Shared callback proof for Unipile Hosted Auth (separate from its API key).
UNIPILE_CALLBACK_SECRET=
UNIPILE_DSN=
UNIPILE_API_KEY=

# ---- Billing and provider webhooks ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Configure Supabase Auth custom SMTP using Resend in the Supabase dashboard.
# SMTP credentials are not used by the Next.js server directly.

# Gate Vercel cron routes in production (scheduler will 401 without this).
CRON_SECRET=

# ---- Personalized video (parked: VIDEO_GENERATION_ENABLED in src/lib/constants.js) ----
# Avatar/voice cloning. Unused until that flag is turned back on.
HEYGEN_API_KEY=
ELEVENLABS_API_KEY=

# Base URL used in generated pitch links
NEXT_PUBLIC_BASE_URL=http://localhost:3000
